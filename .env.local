# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in the Supabase dashboard: Project Settings -> API.

# Public — safe to expose in the browser. Used for read-only queries on the
# public site. RLS policies (see supabase/schema.sql) only allow SELECT with
# this key, so exposing it is safe.
